<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Jack The Code Bender — the Designer's code assistant.

    Everything here is editable from the chat panel's Settings flyout too; the
    panel writes changes back to this file, so app.config is the source of truth
    for behaviour.

    Credentials are the exception. This file is in the repository, so it holds
    only ${ENV_VAR} placeholders, resolved at startup. Put real keys either in
    the environment or in rustnet-designer.secrets.config, which is gitignored
    and pulled in by the file= attribute below — see the .example beside it.
    Anything set there wins over the placeholder here.
  -->
  <appSettings file="rustnet-designer.secrets.config">

    <add key="Assistant.Enabled" value="true" />
    <!-- OpenAI | Anthropic | Gemini | Ollama -->
    <add key="Assistant.Provider" value="OpenAI" />
    <add key="Assistant.Streaming" value="true" />
    <add key="Assistant.Temperature" value="0.35" />
    <add key="Assistant.TopP" value="0.95" />
    <add key="Assistant.MaxTokens" value="8192" />
    <!-- Tool-calling rounds the model may take before it must answer. -->
    <add key="Assistant.MaxToolIterations" value="12" />
    <!-- Past messages replayed to the model on each turn (0 = the whole session). -->
    <add key="Assistant.HistoryTurns" value="40" />
    <!-- Sessions + uploaded attachments. Blank = %APPDATA%\RustNet\Designer\assistant -->
    <add key="Assistant.DataDirectory" value="" />
    <!-- Repo/SDK root the docs and template functions read from.
         Blank = $(RUSTNET_SDK), else auto-detected by walking up from the exe. -->
    <add key="Assistant.WorkspaceRoot" value="" />

    <!-- The persona. \n is honoured, so the prompt can be paragraphed. -->
    <add key="Assistant.Persona" value="You are Jack The Code Bender, the resident code assistant inside the RustNet UI Designer.\nRustNet runs C#/.NET applications on microcontrollers: a C# app is compiled, rewritten into a compact RNX module, signed, flashed over RNDP and executed by a Rust IL interpreter on the device. You help the person at the Designer shape embedded UI and the app code behind it.\n\nWhat you know about the target:\n- Screens are small and RGB565. Colors are 16-bit hex like F800 (red), 07E0 (green), 001F (blue), FFFF (white), 0000 (black).\n- Layout markup is the RustNet.UI XML format. Call get_ui_reference before writing any layout so you use only the kinds and attributes that exist.\n- Immediate-mode drawing is RustNet.Graphics.Display. Call get_graphics_reference before writing drawing code.\n- The interpreter supports a large but not complete slice of C#. Call get_language_limits when you are about to use anything beyond the core language.\n\nHow you work:\n- Prefer doing over describing. When the person asks for a screen, generate the layout and apply it with apply_layout_xml so it appears on their canvas, then explain the choices in two or three sentences.\n- When you write app code, put it in the code pane with set_generated_code instead of only pasting it in chat.\n- Verify layouts with validate_layout_xml before applying them.\n- Use the tools you have rather than guessing: search the web for datasheets and protocol details, read the RustNet docs for API facts, compute numbers instead of estimating them.\n- Design for the panel you are given. Ask for the panel size once if it matters and is unknown; otherwise assume 320x240 and say so.\n- Be concrete and brief. Show the code, name the tradeoff, skip the preamble. Use markdown: tables for pin maps and property lists, fenced blocks with a language tag for code." />

    <!-- Providers -->

    <add key="Assistant.OpenAI.ApiKey" value="${OPENAI_API_KEY}" />
    <add key="Assistant.OpenAI.Model" value="gpt-4o" />
    <add key="Assistant.OpenAI.Models" value="gpt-5,gpt-5-mini,gpt-4.1,gpt-4.1-mini,o4-mini" />
    <!-- Blank = api.openai.com. Set for an OpenAI-compatible gateway. -->
    <add key="Assistant.OpenAI.Endpoint" value="https://api.openai.com/v1" />

    <add key="Assistant.Anthropic.ApiKey" value="${ANTHROPIC_API_KEY}" />
    <add key="Assistant.Anthropic.Model" value="claude-opus-5" />
    <add key="Assistant.Anthropic.Models" value="claude-opus-5,claude-sonnet-5,claude-haiku-4-5-20251001" />

    <add key="Assistant.Gemini.ApiKey" value="${GEMINI_API_KEY}" />
    <add key="Assistant.Gemini.Model" value="gemini-2.5-pro" />
    <add key="Assistant.Gemini.Models" value="gemini-2.5-pro,gemini-2.5-flash" />

    <!-- Ollama needs no key; point it at your daemon. -->
    <add key="Assistant.Ollama.Endpoint" value="http://localhost:11434" />
    <add key="Assistant.Ollama.Model" value="qwen2.5-coder:14b" />
    <add key="Assistant.Ollama.Models" value="qwen2.5-coder:14b,qwen3:14b,llama3.1:8b,devstral:24b" />

    <!-- Tools -->

    <add key="Tools.Enabled" value="true" />
    <!-- Internet search. Without a key the search function reports that it is
         unconfigured instead of failing the turn. https://tavily.com -->
    <add key="Tools.Tavily.ApiKey" value="${TAVILY_API_KEY}" />
    <add key="Tools.Tavily.MaxResults" value="5" />
    <add key="Tools.Http.TimeoutSeconds" value="30" />
    <!-- Cap on what a fetched page or file may contribute to the context. -->
    <add key="Tools.Http.MaxChars" value="60000" />

    <!-- Attachments -->

    <add key="Attachments.MaxImageBytes" value="5000000" />
    <!-- How much of an attached text document is inlined for the model. -->
    <add key="Attachments.MaxDocumentChars" value="40000" />
  </appSettings>
</configuration>
