<?xml version="1.0" encoding="utf-8"?>
<!--
  Local secrets for the Designer's assistant. Gitignored: real keys belong here,
  never in App.config, which is tracked.

  App.config pulls this in with <appSettings file="rustnet-designer.secrets.config">,
  so any key set here overrides the placeholder there. Copy
  rustnet-designer.secrets.config.example to this name and fill it in.
-->
<appSettings>
  <add key="Assistant.OpenAI.ApiKey" value="sk-proj-xxx" />
  <add key="Tools.Tavily.ApiKey" value="tvly-dev-xxx" />
</appSettings>
