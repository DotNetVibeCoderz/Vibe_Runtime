<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RustNet.Workbench.MainWindow"
        Title="RustNet Workbench"
        Width="1120" Height="760" MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterScreen">

  <DockPanel>

    <!-- Enclosure top: the wordmark, and the one field that decides which
         board everything else talks to. -->
    <Border DockPanel.Dock="Top" Background="{StaticResource Panel}"
            BorderBrush="{StaticResource Edge}" BorderThickness="0 0 0 1" Padding="18 12">
      <DockPanel>
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Border Width="4" Height="22" Background="{StaticResource Amber}"/>
          <TextBlock Text="RUSTNET" FontFamily="{StaticResource LegendFace}" FontSize="18"
                     LetterSpacing="3.5" Foreground="{StaticResource Legend}" VerticalAlignment="Center"/>
          <TextBlock Text="WORKBENCH" FontFamily="{StaticResource LegendFace}" FontSize="18"
                     LetterSpacing="3.5" Foreground="{StaticResource LegendDim}" VerticalAlignment="Center"/>
        </StackPanel>

        <Button DockPanel.Dock="Right" x:Name="BtnConnect" Classes="primary"
                Content="CONNECT" Click="OnConnect" Margin="8 0 0 0"/>
        <TextBox DockPanel.Dock="Right" x:Name="TxtDevice" Text="tcp:127.0.0.1:7878" Width="260"
                 FontFamily="{StaticResource DataFace}" FontSize="12"
                 Watermark="serial:COM5 or tcp:host:port"/>
        <TextBlock DockPanel.Dock="Right" Classes="legend" Text="DEVICE" VerticalAlignment="Center"
                   Margin="0 0 10 0"/>
        <Panel/>
      </DockPanel>
    </Border>

    <!--
      The readout.

      This is the one element the tool is remembered by, and it earns the
      space: the question a person has in front of a board is "is it alive,
      and what is it doing?", and every other panel is a detail of that. It
      stays visible in every mode, in the data face, on inset glass — the
      instrument's display window rather than a status bar.
    -->
    <Border DockPanel.Dock="Top" Background="{StaticResource Readout}"
            BorderBrush="{StaticResource Edge}" BorderThickness="0 0 0 1" Padding="18 10">
      <DockPanel>
        <Ellipse DockPanel.Dock="Left" x:Name="LampState" Width="9" Height="9"
                 Fill="{StaticResource LampOff}" VerticalAlignment="Center" Margin="0 0 12 0"/>
        <TextBlock DockPanel.Dock="Right" x:Name="LblStatus" Text="not connected"
                   FontFamily="{StaticResource DataFace}" FontSize="12"
                   Foreground="{StaticResource LegendDim}" VerticalAlignment="Center"
                   Margin="16 0 0 0"/>
        <TextBlock x:Name="TxtReadout" Classes="readout" VerticalAlignment="Center"
                   Text="no device — enter a port and connect"
                   Foreground="{StaticResource LegendDim}" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
    </Border>

    <!-- Mode rail down the side. Which panel you are on is which mode the
         instrument is in; the readout above never goes away.

         The rail is a column of the enclosure, so it is painted as one: the
         border behind it runs the full height whether or not there are enough
         modes to reach the bottom. Without it the labels float on the same
         surface as the content and the eye has nothing to separate. -->
    <Grid ColumnDefinitions="150,*">
      <Border Grid.Column="0" Background="{StaticResource Panel}"
              BorderBrush="{StaticResource Edge}" BorderThickness="0 0 1 0"/>
      <TabControl Grid.Column="0" Grid.ColumnSpan="2" TabStripPlacement="Left" Margin="0">

        <TabItem Header="DEVICE">
          <ScrollViewer>
            <StackPanel Spacing="14" Margin="20">

              <Border Classes="group">
                <StackPanel Spacing="10">
                  <TextBlock Classes="legend" Text="REPORTED STATE"/>
                  <TextBox x:Name="TxtInfo" Classes="data" IsReadOnly="True" Height="110"
                           TextWrapping="Wrap" Watermark="connect to read the device"/>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="REFRESH" Click="OnRefreshInfo"/>
                    <Button Classes="danger" Content="REBOOT" Click="OnReboot"/>
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Classes="group">
                <StackPanel Spacing="10">
                  <TextBlock Classes="legend" Text="SECURE BOOT"/>
                  <TextBlock Classes="note"
                             Text="A device accepts one signing key, once. Generate a pair, keep the private half, and provision the public half — after that only apps you sign will run."/>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="TxtKeyDir" Width="360" Watermark="key directory"/>
                    <Button Content="GENERATE PAIR" Click="OnGenerateKeys"/>
                    <Button Classes="primary" Content="PROVISION" Click="OnProvision"/>
                  </StackPanel>
                  <TextBlock x:Name="LblKeysInfo" Classes="note"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="APPS">
          <DockPanel Margin="20">
            <StackPanel DockPanel.Dock="Top" Spacing="14">

              <Border Classes="group">
                <StackPanel Spacing="10">
                  <TextBlock Classes="legend" Text="FLASH"/>
                  <TextBlock Classes="note"
                             Text="A .dll is compiled to RNX and signed on the way through. Pick the chip the image is for — a device rejects an image built for another."/>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="TxtAppPath" Width="300" Watermark="app .dll or .rnx"/>
                    <TextBox x:Name="TxtAppName" Width="130" Watermark="name on device"/>
                    <ComboBox x:Name="CmbChip" Width="120" SelectedIndex="0">
                      <ComboBoxItem>host-sim</ComboBoxItem>
                      <ComboBoxItem>esp32</ComboBoxItem>
                      <ComboBoxItem>esp32c3</ComboBoxItem>
                      <ComboBoxItem>k210</ComboBoxItem>
                      <ComboBoxItem>rp2040</ComboBoxItem>
                      <ComboBoxItem>stm32</ComboBoxItem>
                      <ComboBoxItem>ti</ComboBoxItem>
                      <ComboBoxItem>nxp</ComboBoxItem>
                    </ComboBox>
                    <Button Classes="primary" Content="FLASH" Click="OnFlashApp"/>
                  </StackPanel>
                </StackPanel>
              </Border>

              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="REFRESH LIST" Click="OnRefreshApps"/>
                <Button Content="START" Click="OnStartApp"/>
                <Button Content="STOP" Click="OnStopApp"/>
                <Button Classes="danger" Content="ERASE" Click="OnEraseApp"/>
              </StackPanel>
              <TextBlock Classes="legend" Text="STORED ON DEVICE"/>
            </StackPanel>
            <ListBox x:Name="LstApps" Margin="0 8 0 0"/>
          </DockPanel>
        </TabItem>

        <TabItem Header="FILES">
          <ScrollViewer>
            <StackPanel Spacing="14" Margin="20">
              <Border Classes="group">
                <StackPanel Spacing="10">
                  <TextBlock Classes="legend" Text="DEVICE FILESYSTEM"/>
                  <TextBlock Classes="note"
                             Text="Assets an application reads at runtime: configuration, images, anything it opens by name."/>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="TxtDataLocal" Width="320" Watermark="local file"/>
                    <TextBox x:Name="TxtDataRemote" Width="200" Watermark="name on device"/>
                    <Button Classes="primary" Content="PUSH" Click="OnDataPush"/>
                    <Button Content="PULL" Click="OnDataPull"/>
                  </StackPanel>
                  <TextBox x:Name="TxtDataOut" Classes="data" IsReadOnly="True" Height="240"
                           TextWrapping="Wrap" AcceptsReturn="True"
                           Watermark="pulled content appears here"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="CONFIG">
          <ScrollViewer>
            <StackPanel Spacing="14" Margin="20">

              <Border Classes="group">
                <StackPanel Spacing="10">
                  <TextBlock Classes="legend" Text="SETTINGS"/>
                  <TextBlock Classes="note"
                             Text="Key/value settings, encrypted on the device's flash. An application reads them by key."/>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="TxtCfgKey" Width="200" Watermark="key, e.g. api.token"/>
                    <TextBox x:Name="TxtCfgValue" Width="300" Watermark="value"/>
                    <Button Classes="primary" Content="SET" Click="OnConfigSet"/>
                    <Button Content="GET" Click="OnConfigGet"/>
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Classes="group">
                <StackPanel Spacing="10">
                  <TextBlock Classes="legend" Text="WIFI"/>
                  <TextBlock Classes="note"
                             Text="Stored on the device, not in your application. The password is written, never read back."/>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="TxtSsid" Width="220" Watermark="network name"/>
                    <TextBox x:Name="TxtPsk" Width="220" Watermark="password" PasswordChar="•"/>
                    <Button Classes="primary" Content="SAVE TO DEVICE" Click="OnWifiSave"/>
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Classes="group">
                <StackPanel Spacing="10">
                  <TextBlock Classes="legend" Text="BOOT SPLASH"/>
                  <TextBlock Classes="note"
                             Text="A raw RGB565 image shown while the device starts. Width and height must match the file."/>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="TxtBootFile" Width="300" Watermark=".rgb565 file"/>
                    <TextBox x:Name="TxtBootW" Width="80" Watermark="width"/>
                    <TextBox x:Name="TxtBootH" Width="80" Watermark="height"/>
                    <Button Classes="primary" Content="UPLOAD" Click="OnBootSet"/>
                    <Button Content="DOWNLOAD" Click="OnBootGet"/>
                  </StackPanel>
                  <TextBlock x:Name="LblBootOut" Classes="note"/>
                </StackPanel>
              </Border>

              <TextBlock x:Name="LblCfgOut" Classes="note"/>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="DISPLAY">
          <DockPanel Margin="20">
            <StackPanel DockPanel.Dock="Top" Spacing="12">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Classes="primary" Content="CAPTURE" Click="OnCaptureDisplay"/>
                <TextBlock x:Name="LblDisplayInfo" Classes="note" VerticalAlignment="Center"/>
              </StackPanel>
            </StackPanel>
            <Border Margin="0 14 0 0" Background="{StaticResource Readout}"
                    BorderBrush="{StaticResource Edge}" BorderThickness="1" Padding="14">
              <Image x:Name="ImgDisplay" Stretch="Uniform"
                     RenderOptions.BitmapInterpolationMode="None"/>
            </Border>
          </DockPanel>
        </TabItem>

        <TabItem Header="LOGS">
          <DockPanel Margin="20">
            <StackPanel DockPanel.Dock="Top" Spacing="12">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Classes="primary" Content="REFRESH" Click="OnRefreshLogs"/>
                <CheckBox x:Name="ChkFollow" Content="Follow, once a second" VerticalAlignment="Center"/>
              </StackPanel>
            </StackPanel>
            <TextBox x:Name="TxtLogs" Classes="data" IsReadOnly="True" Margin="0 12 0 0"
                     AcceptsReturn="True" Watermark="the device's log ring appears here"/>
          </DockPanel>
        </TabItem>

        <TabItem Header="PROFILER">
          <ScrollViewer>
            <StackPanel Spacing="14" Margin="20">
              <Border Classes="group">
                <StackPanel Spacing="10">
                  <TextBlock Classes="legend" Text="COUNTERS"/>
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Classes="primary" Content="SAMPLE" Click="OnRefreshPerf"/>
                    <CheckBox x:Name="ChkPerfWatch" Content="Watch, once a second" VerticalAlignment="Center"/>
                  </StackPanel>
                  <TextBox x:Name="TxtPerf" Classes="data" IsReadOnly="True" Height="200"
                           TextWrapping="Wrap" AcceptsReturn="True"
                           Watermark="CPU, heap, GC and instruction counters"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="OTA">
          <ScrollViewer>
            <StackPanel Spacing="14" Margin="20">
              <Border Classes="group">
                <StackPanel Spacing="10">
                  <TextBlock Classes="legend" Text="OVER THE AIR"/>
                  <TextBlock Classes="note"
                             Text="Signed, into the spare slot, with automatic rollback. The device runs the new image once; confirm it healthy or it reverts on the next boot."/>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="TxtOtaFile" Width="300" Watermark="firmware payload"/>
                    <TextBox x:Name="TxtOtaKey" Width="240" Watermark="private key (.key)"/>
                    <Button Classes="primary" Content="PUSH UPDATE" Click="OnOtaPush"/>
                  </StackPanel>
                  <ProgressBar x:Name="PrgOta" Minimum="0" Maximum="100"/>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="CONFIRM HEALTHY" Click="OnOtaConfirm"/>
                    <Button Classes="danger" Content="ROLL BACK" Click="OnOtaRollback"/>
                  </StackPanel>
                  <TextBlock x:Name="LblOtaOut" Classes="note"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="FIRMWARE">
          <DockPanel Margin="20">
            <StackPanel DockPanel.Dock="Top" Spacing="14">
              <Border Classes="group">
                <StackPanel Spacing="10">
                  <TextBlock Classes="legend" Text="HOST VIRTUAL DEVICE"/>
                  <TextBlock Classes="note"
                             Text="Builds the host firmware with one chip identity linked in — the virtual device you develop against, not an image for real silicon. For a real board, use the panel below."/>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox x:Name="CmbFwChip" Width="120" SelectedIndex="0">
                      <ComboBoxItem>host</ComboBoxItem>
                      <ComboBoxItem>esp32</ComboBoxItem>
                      <ComboBoxItem>esp32c3</ComboBoxItem>
                      <ComboBoxItem>k210</ComboBoxItem>
                      <ComboBoxItem>stm32</ComboBoxItem>
                      <ComboBoxItem>ti</ComboBoxItem>
                      <ComboBoxItem>nxp</ComboBoxItem>
                    </ComboBox>
                    <Button Classes="primary" Content="BUILD" Click="OnFwBuild"/>
                    <Button Content="LIST IMAGES" Click="OnFwList"/>
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Classes="group">
                <StackPanel Spacing="10">
                  <TextBlock Classes="legend" Text="BOARD FIRMWARE"/>
                  <TextBlock Classes="note"
                             Text="Builds and flashes the bare-metal firmware for a real board. Each port is its own workspace and needs that target's toolchain and flashing tool installed — the readout below says which, and the build stops with a plain message if one is missing."/>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox x:Name="CmbBoard" Width="230" SelectionChanged="OnBoardChanged"/>
                    <TextBox x:Name="TxtBoardPort" Width="110" Watermark="COM7"/>
                    <Button x:Name="BtnBoardBuild" Classes="primary" Content="BUILD" Click="OnBoardBuild"/>
                    <Button x:Name="BtnBoardFlash" Content="FLASH" Click="OnBoardFlash"/>
                    <Button x:Name="BtnBoardBoth" Content="BUILD + FLASH" Click="OnBoardBuildFlash"/>
                  </StackPanel>
                  <TextBlock x:Name="LblBoardNote" Classes="note" Text=""/>
                  <TextBlock x:Name="LblBoardArtifact" Classes="readout" Text=""/>
                </StackPanel>
              </Border>
            </StackPanel>
            <TextBox x:Name="TxtFwOut" Classes="data" IsReadOnly="True" Margin="0 12 0 0"
                     AcceptsReturn="True" Watermark="cargo output appears here"/>
          </DockPanel>
        </TabItem>

        <TabItem Header="ABOUT">
          <ScrollViewer>
            <StackPanel Spacing="14" Margin="20" MaxWidth="720" HorizontalAlignment="Left">

              <Border Classes="group">
                <StackPanel Spacing="12">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Width="4" Height="20" Background="{StaticResource Amber}"/>
                    <TextBlock Text="RUSTNET WORKBENCH" FontFamily="{StaticResource LegendFace}"
                               FontSize="16" LetterSpacing="2.4" Foreground="{StaticResource Legend}"/>
                  </StackPanel>
                  <TextBlock Classes="note"
                             Text="RustNet runs C# applications on microcontrollers. A .NET assembly is rewritten into a compact RNX module, sealed into a signed container, and executed by an IL interpreter written in Rust. This tool is the bench side of that: it provisions a board, flashes applications to it, and watches what they do."/>
                  <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="legend" Text="WORKBENCH"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="LblAboutVersion" Classes="readout" Text="—"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="legend" Text="PROTOCOL" Margin="0 6 0 0"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="LblAboutProtocol" Classes="readout"
                               Text="RNDP v1" Margin="0 6 0 0"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Classes="legend" Text="TRANSPORTS" Margin="0 6 0 0"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Classes="readout"
                               Text="serial · tcp · ble" Margin="0 6 0 0"/>
                  </Grid>
                </StackPanel>
              </Border>

              <Border Classes="group">
                <StackPanel Spacing="10">
                  <TextBlock Classes="legend" Text="BOARDS THIS TOOL DRIVES"/>
                  <TextBlock Classes="note"
                             Text="Every board below speaks RNDP, so provisioning, flashing, apps, files, config, logs and the display work the same way on all of them. What differs is where the firmware comes from."/>
                  <TextBox x:Name="TxtAboutBoards" Classes="data" IsReadOnly="True" Height="200"
                           AcceptsReturn="True" TextWrapping="NoWrap"/>
                </StackPanel>
              </Border>

              <Border Classes="group">
                <StackPanel Spacing="8">
                  <TextBlock Classes="legend" Text="DOCUMENTATION"/>
                  <TextBlock Classes="note" Text="In the repository, alongside this tool:"/>
                  <TextBlock Classes="readout" Text="docs/architecture.md    how the pieces fit"/>
                  <TextBlock Classes="readout" Text="docs/protocol.md        RNDP frames and commands"/>
                  <TextBlock Classes="readout" Text="docs/chips.md           what each chip supports"/>
                  <TextBlock Classes="readout" Text="docs/deploy-esp32.md    ESP32 and M5Stack"/>
                  <TextBlock Classes="readout" Text="docs/deploy-maixgo.md   Sipeed Maix Go (K210)"/>
                  <TextBlock Classes="readout" Text="docs/deploy-pico.md     Raspberry Pi Pico"/>
                  <TextBlock Classes="readout" Text="docs/deploy-m5core2.md  M5Stack Core2"/>
                  <TextBlock Classes="readout" Text="docs/deploy-xiao-c3.md  Seeed XIAO ESP32C3"/>
                  <TextBlock Classes="readout" Text="docs/dotnet-support.md  the C# language surface"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

      </TabControl>
    </Grid>
  </DockPanel>
</Window>
