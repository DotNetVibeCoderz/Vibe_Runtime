<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CodeGen.Views.MessageWindow"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{StaticResource Graphite}"
        Foreground="{StaticResource Bone}">
  <StackPanel Margin="22" Spacing="14">
    <TextBlock Name="Heading" Classes="panel-label" Foreground="{StaticResource Oxide}" />
    <TextBlock Name="Body" Classes="prose" />
    <Button Classes="accent" Content="Close" HorizontalAlignment="Right" Click="OnClose" IsDefault="True" />
  </StackPanel>
</Window>
