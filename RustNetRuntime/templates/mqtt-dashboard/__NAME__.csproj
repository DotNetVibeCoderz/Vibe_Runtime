<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>__NAME__</AssemblyName>
    <RootNamespace>__NAME__</RootNamespace>
    <RustNetSdk Condition="'$(RustNetSdk)' == ''">$(MSBuildThisFileDirectory)../..</RustNetSdk>
  </PropertyGroup>

  <!--
    Only the libraries this program uses. That is not tidiness: a board
    registers every type in every assembly it loads, whether the program
    mentions them or not, so a reference to a library you do not call is
    metadata and method-table entries you pay for on a chip with kilobytes.
    Measured on `graphics-primitives`: two libraries register 253 types and 68
    methods, one combined library 320 and 498.
  -->
  <ItemGroup>
    <ProjectReference Include="$(RustNetSdk)/managed/RustNet.Core/RustNet.Core.csproj" />
    <ProjectReference Include="$(RustNetSdk)/managed/RustNet.Graphics/RustNet.Graphics.csproj" />
    <ProjectReference Include="$(RustNetSdk)/managed/RustNet.Net/RustNet.Net.csproj" />
  </ItemGroup>

</Project>
