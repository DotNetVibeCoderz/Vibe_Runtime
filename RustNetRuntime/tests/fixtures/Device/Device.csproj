<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Device</AssemblyName>
    <RootNamespace>Device</RootNamespace>
  </PropertyGroup>

  <!--
    Only the libraries it exercises, by path. The fixture exists to prove the
    assembly RustCLR loads is the one the SDK built, so a package feed in
    between would be one more thing that could differ.
  -->
  <ItemGroup>
    <ProjectReference Include="../../../managed/RustNet.Hal/RustNet.Hal.csproj" />
    <ProjectReference Include="../../../managed/RustNet.IO/RustNet.IO.csproj" />
    <ProjectReference Include="../../../managed/RustNet.Security/RustNet.Security.csproj" />
    <ProjectReference Include="../../../managed/RustNet.Graphics/RustNet.Graphics.csproj" />
    <ProjectReference Include="../../../managed/RustNet.Media/RustNet.Media.csproj" />
  </ItemGroup>

</Project>
