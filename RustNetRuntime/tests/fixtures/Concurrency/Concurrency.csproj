<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Concurrency</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    By path, like the Device fixture: the assembly RustCLR loads is the one the
    SDK built, with no package feed in between.
  -->
  <ItemGroup>
    <ProjectReference Include="../../../managed/RustNet.Concurrency/RustNet.Concurrency.csproj" />
  </ItemGroup>

</Project>
